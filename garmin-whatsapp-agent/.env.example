# Clave para cifrar secretos en data/config.json (obligatoria en produccion)
# Genera una con: openssl rand -hex 32
MASTER_KEY=

# Directorio de datos persistente (tokens de Garmin, config, sesiones)
# En Docker/Fly/Railway montalo como volumen
DATA_DIR=./data

# Overrides opcionales de endpoints de Kapso
# KAPSO_PLATFORM_API=https://api.kapso.ai/platform/v1
# KAPSO_META_PROXY=https://app.kapso.ai/api/meta
